<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>منصة المؤرخ | للدراسات الاجتماعية</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;700;900&display=swap" rel="stylesheet">
    
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body { font-family: 'Tajawal', sans-serif; background-color: #f3f4f6; }
        /* تأثيرات إضافية */
        .glass-panel {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        .gradient-text {
            background: linear-gradient(to right, #2563eb, #10b981);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
        /* إخفاء شريط التمرير للقوائم الجانبية */
        .hide-scrollbar::-webkit-scrollbar { display: none; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 antialiased">

<div id="app" class="min-h-screen flex flex-col">

    <header class="sticky top-0 z-50 glass-panel shadow-sm">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center gap-3 cursor-pointer" @click="currentView = 'home'">
                <div class="bg-blue-600 text-white p-2 rounded-lg shadow-lg">
                    <i class="fa-solid fa-earth-africa fa-lg"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-gray-900">المؤرخ</h1>
                    <p class="text-xs text-gray-500">منصة الدراسات الاجتماعية المتطورة</p>
                </div>
            </div>
            
            <nav class="hidden md:flex gap-6 text-sm font-medium text-gray-600">
                <a href="#" @click.prevent="currentView = 'home'" class="hover:text-blue-600 transition">الرئيسية</a>
                <a href="#" class="hover:text-blue-600 transition">عن المنصة</a>
                <a href="#" class="hover:text-blue-600 transition">تواصل معنا</a>
            </nav>

            <button class="bg-gray-900 text-white px-5 py-2 rounded-full text-sm hover:bg-gray-800 transition shadow-md">
                دخول الطالب
            </button>
        </div>
    </header>

    <main class="flex-grow container mx-auto px-4 py-8">
        
        <div v-if="currentView === 'home'" class="animate-fade-in">
            <div class="text-center mb-12">
                <span class="bg-blue-100 text-blue-700 px-4 py-1 rounded-full text-xs font-bold tracking-wide">النسخة الجديدة 2.0</span>
                <h2 class="text-4xl md:text-5xl font-extrabold mt-4 mb-4">
                    تعلم التاريخ والجغرافيا <br>
                    <span class="gradient-text">بشكل لم تره من قبل</span>
                </h2>
                <p class="text-gray-500 max-w-2xl mx-auto text-lg">منصة تفاعلية تغطي مناهج الدراسات الاجتماعية من الصف الرابع الابتدائي وحتى الثالث الإعدادي.</p>
            </div>

            <div class="flex flex-wrap justify-center gap-3 mb-10">
                <button 
                    v-for="grade in grades" 
                    :key="grade.id"
                    @click="activeGrade = grade.id"
                    :class="activeGrade === grade.id ? 'bg-blue-600 text-white shadow-lg scale-105' : 'bg-white text-gray-600 hover:bg-gray-100 border border-gray-200'"
                    class="px-6 py-3 rounded-xl transition-all duration-300 font-bold text-sm"
                >
                    {{ grade.name }}
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <div 
                    v-for="lesson in filteredLessons" 
                    :key="lesson.id" 
                    @click="openLesson(lesson)"
                    class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 card-hover cursor-pointer transition-all duration-300 group"
                >
                    <div class="relative h-48 overflow-hidden">
                        <img :src="lesson.image" class="w-full h-full object-cover group-hover:scale-110 transition duration-500" alt="درس">
                        <div class="absolute top-3 right-3 bg-white/90 backdrop-blur px-3 py-1 rounded-lg text-xs font-bold shadow-sm"
                             :class="lesson.subject === 'history' ? 'text-amber-600' : 'text-teal-600'">
                            <i :class="lesson.subject === 'history' ? 'fa-solid fa-scroll' : 'fa-solid fa-map-location-dot'"></i>
                            {{ lesson.subject === 'history' ? 'تاريخ' : 'جغرافيا' }}
                        </div>
                    </div>
                    <div class="p-5">
                        <h3 class="text-lg font-bold text-gray-900 mb-2">{{ lesson.title }}</h3>
                        <p class="text-gray-500 text-sm mb-4 line-clamp-2">{{ lesson.desc }}</p>
                        <div class="flex justify-between items-center border-t pt-4 border-gray-100">
                            <span class="text-xs text-gray-400 font-medium"><i class="fa-regular fa-clock ml-1"></i> {{ lesson.duration }} دقيقة</span>
                            <span class="text-blue-600 text-sm font-bold group-hover:translate-x-[-5px] transition-transform">ابدأ الدرس <i class="fa-solid fa-arrow-left mr-1"></i></span>
                        </div>
                    </div>
                </div>
            </div>

            <div v-if="filteredLessons.length === 0" class="text-center py-20 text-gray-400">
                <i class="fa-solid fa-box-open text-4xl mb-3"></i>
                <p>لا توجد دروس متاحة لهذا الصف حالياً</p>
            </div>
        </div>

        <div v-if="currentView === 'lesson'" class="grid grid-cols-1 lg:grid-cols-12 gap-8 animate-fade-in">
            <div class="lg:col-span-3">
                <button @click="currentView = 'home'" class="flex items-center text-gray-500 hover:text-blue-600 mb-6 transition">
                    <i class="fa-solid fa-arrow-right ml-2"></i> العودة للدروس
                </button>
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 sticky top-24">
                    <h3 class="font-bold text-gray-900 mb-4 border-b pb-2">محتويات الدرس</h3>
                    <ul class="space-y-3">
                        <li v-for="(section, index) in activeLesson.sections" :key="index" 
                            class="flex items-center text-sm text-gray-600 hover:text-blue-600 cursor-pointer p-2 hover:bg-blue-50 rounded-lg transition">
                            <span class="bg-blue-100 text-blue-600 w-6 h-6 flex items-center justify-center rounded-full text-xs font-bold ml-2">{{ index + 1 }}</span>
                            {{ section.title }}
                        </li>
                    </ul>
                    <button @click="startQuiz" class="w-full mt-6 bg-gradient-to-r from-blue-600 to-blue-500 text-white py-3 rounded-xl font-bold shadow-lg hover:shadow-xl transition">
                        <i class="fa-solid fa-clipboard-question ml-2"></i> اختبار الدرس
                    </button>
                </div>
            </div>

            <div class="lg:col-span-9">
                <div v-if="!isQuizMode">
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-6">
                        <div class="relative h-64 md:h-80">
                            <img :src="activeLesson.image" class="w-full h-full object-cover">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end">
                                <div class="p-8 text-white">
                                    <span class="bg-blue-600 px-3 py-1 rounded text-xs font-bold mb-2 inline-block">الصف {{ getGradeName(activeLesson.gradeId) }}</span>
                                    <h1 class="text-3xl md:text-4xl font-bold">{{ activeLesson.title }}</h1>
                                </div>
                            </div>
                        </div>
                        <div class="p-8 leading-relaxed text-gray-700">
                            <p class="text-lg mb-6 font-medium">{{ activeLesson.desc }}</p>
                            
                            <div class="space-y-8">
                                <div v-for="section in activeLesson.sections" :key="section.title">
                                    <h2 class="text-2xl font-bold text-gray-900 mb-3 flex items-center">
                                        <i class="fa-solid fa-caret-left text-blue-600 ml-2"></i> {{ section.title }}
                                    </h2>
                                    <p class="text-gray-600">{{ section.content }}</p>
                                    <div v-if="section.note" class="bg-yellow-50 border-r-4 border-yellow-400 p-4 rounded-lg mt-3 text-sm text-yellow-800">
                                        <strong><i class="fa-regular fa-lightbulb ml-1"></i> معلومة إثرائية:</strong> {{ section.note }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div v-else class="bg-white rounded-2xl shadow-lg border border-gray-100 p-8 text-center max-w-2xl mx-auto mt-10">
                    <div v-if="!quizFinished">
                        <div class="mb-6 flex justify-between items-center">
                            <span class="text-sm text-gray-400">سؤال {{ currentQuestion + 1 }} من {{ activeLesson.quiz.length }}</span>
                            <span class="bg-blue-100 text-blue-600 px-3 py-1 rounded-full text-xs font-bold">اختبار تفاعلي</span>
                        </div>
                        <h3 class="text-2xl font-bold text-gray-800 mb-8">{{ activeLesson.quiz[currentQuestion].question }}</h3>
                        <div class="grid gap-3">
                            <button v-for="(option, idx) in activeLesson.quiz[currentQuestion].options" :key="idx"
                                @click="checkAnswer(idx)"
                                class="p-4 rounded-xl border-2 border-gray-100 hover:border-blue-500 hover:bg-blue-50 text-right transition font-medium text-gray-700 group">
                                <span class="w-8 h-8 rounded-full bg-gray-200 text-gray-500 inline-flex items-center justify-center ml-3 text-sm font-bold group-hover:bg-blue-500 group-hover:text-white transition">{{ idx + 1 }}</span>
                                {{ option }}
                            </button>
                        </div>
                    </div>
                    
                    <div v-else class="py-10">
                        <div class="w-24 h-24 bg-green-100 text-green-500 rounded-full flex items-center justify-center text-4xl mx-auto mb-6">
                            <i class="fa-solid fa-trophy"></i>
                        </div>
                        <h3 class="text-3xl font-bold text-gray-900 mb-2">أحسنت يا بطل!</h3>
                        <p class="text-gray-500 mb-6">لقد أجبت على {{ score }} من {{ activeLesson.quiz.length }} أسئلة بشكل صحيح.</p>
                        <button @click="isQuizMode = false; quizFinished = false; currentQuestion = 0; score = 0" 
                            class="bg-gray-900 text-white px-8 py-3 rounded-xl font-bold hover:bg-gray-800 transition shadow-lg">
                            العودة للدرس
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <footer class="bg-gray-900 text-gray-400 py-8 text-center text-sm">
        <p>© 2024 منصة المؤرخ التعليمية. جميع الحقوق محفوظة.</p>
    </footer>

</div>

<script>
    const { createApp } = Vue;

    createApp({
        data() {
            return {
                currentView: 'home',
                activeGrade: 'primary4',
                isQuizMode: false,
                quizFinished: false,
                currentQuestion: 0,
                score: 0,
                activeLesson: null,
                grades: [
                    { id: 'primary4', name: 'الرابع الابتدائي' },
                    { id: 'primary5', name: 'الخامس الابتدائي' },
                    { id: 'primary6', name: 'السادس الابتدائي' },
                    { id: 'prep1', name: 'الأول الإعدادي' },
                    { id: 'prep2', name: 'الثاني الإعدادي' },
                    { id: 'prep3', name: 'الثالث الإعدادي' },
                ],
                // قاعدة البيانات (يمكنك إضافة مئات الدروس هنا)
                lessons: [
                    {
                        id: 1,
                        gradeId: 'primary4',
                        subject: 'geography',
                        title: 'أدوات تحديد المواقع',
                        desc: 'سنتعرف في هذا الدرس على الخريطة وعناصرها الأساسية وأهمية الصور الجوية والفضائية.',
                        duration: 15,
                        image: 'https://images.unsplash.com/photo-1524661135-423995f22d0b?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80',
                        sections: [
                            { title: 'ما هي الخريطة؟', content: 'الخريطة هي رسم توضيحي لسطح الأرض أو جزء منه باستخدام الرموز والألوان ومقياس رسم محدد.', note: 'أول خريطة للعالم رسمها الإدريسي.' },
                            { title: 'عناصر الخريطة', content: 'تتكون الخريطة من: عنوان الخريطة، ورده البوصلة، ومقياس الرسم، ومفتاح الخريطة.', note: null }
                        ],
                        quiz: [
                            { question: 'ما هو العنصر الذي يوضح مدلول الرموز والألوان؟', options: ['عنوان الخريطة', 'مفتاح الخريطة', 'مقياس الرسم'], answer: 1 },
                            { question: 'تستخدم لتحديد الاتجاهات الأصلية والفرعية؟', options: ['وردة البوصلة', 'الصور الجوية', 'الخريطة'], answer: 0 }
                        ]
                    },
                    {
                        id: 2,
                        gradeId: 'prep3',
                        subject: 'history',
                        title: 'ثورة 23 يوليو 1952',
                        desc: 'أسباب الثورة وتنظيم الضباط الأحرار وإنجازات الثورة في المجال السياسي والاجتماعي.',
                        duration: 25,
                        image: 'https://images.unsplash.com/photo-1568667256549-094345857637?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80',
                        sections: [
                            { title: 'أسباب الثورة', content: 'استمرار الاحتلال البريطاني، فساد النظام الملكي، وهزيمة حرب فلسطين 1948.', note: null },
                            { title: 'أهداف الثورة', content: 'القضاء على الاستعمار، القضاء على الاقطاع، إقامة جيش وطني قوي.', note: 'قائد الثورة الفعلي هو جمال عبد الناصر.' }
                        ],
                        quiz: [
                            { question: 'من قام بتأسيس تنظيم الضباط الأحرار؟', options: ['محمد نجيب', 'جمال عبد الناصر', 'أنور السادات'], answer: 1 },
                            { question: 'أول قانون للإصلاح الزراعي صدر في شهر؟', options: ['يوليو 1952', 'سبتمبر 1952', 'أكتوبر 1953'], answer: 1 }
                        ]
                    }
                ]
            }
        },
        computed: {
            filteredLessons() {
                return this.lessons.filter(l => l.gradeId === this.activeGrade);
            }
        },
        methods: {
            openLesson(lesson) {
                this.activeLesson = lesson;
                this.currentView = 'lesson';
                this.isQuizMode = false;
                window.scrollTo(0, 0);
            },
            getGradeName(id) {
                return this.grades.find(g => g.id === id)?.name;
            },
            startQuiz() {
                this.isQuizMode = true;
                this.quizFinished = false;
                this.currentQuestion = 0;
                this.score = 0;
            },
            checkAnswer(selectedIndex) {
                const correctIndex = this.activeLesson.quiz[this.currentQuestion].answer;
                if (selectedIndex === correctIndex) this.score++;
                
                if (this.currentQuestion < this.activeLesson.quiz.length - 1) {
                    this.currentQuestion++;
                } else {
                    this.quizFinished = true;
                }
            }
        }
    }).mount('#app');
</script>

</body>
</html>
